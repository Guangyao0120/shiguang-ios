          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создание поискового индекса"
          }
        }
      }
    },
    "搜索索引已就绪。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search index is ready."
          }
        },
        "ja": {
