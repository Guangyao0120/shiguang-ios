          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El índice está listo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поисковый индекс готов."
          }
        }
      }
    },
    "已暂停，重开后从已保存进度继续。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused. Continue from saved progress next time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止しました。次回は保存済みの進捗から再開できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 정지했어요. 다음에 저장된 위치부터 이어가세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa. Continúa desde el progreso guardado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостановлено. В следующий раз можно продолжить с сохранённого места."
          }
        }
      }
    },
    "请先暂停当前整理，再建立搜索索引。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause the current task before indexing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の整理を一時停止してから索引を作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 작업을 일시 정지한 다음 색인을 만드세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa la tarea actual antes de crear el índice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостановите текущую задачу перед индексацией."
          }
        }
      }
    },
    "本地 CLIP · %d/%d 张": {
      "extractionState": "manual",
      "localizations": {
